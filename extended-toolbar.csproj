<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ExtendedToolbar</AssemblyName>
    <RootNamespace>ExtendedToolbar</RootNamespace>
    <PackageId>extended-toolbar</PackageId>
    <Title>Extended Toolbar</Title>
    <Description>Complete modular and customizable toolbar for osu!cc with custom layout, styles, positioning, and zones.</Description>
    <Version>1.0.4</Version>
    <Priority>50</Priority>
    <IconGlyph>Columns</IconGlyph>
    <IsPlugin>true</IsPlugin>
    <RepositoryUrl>https://github.com/Meyblow/extended-toolbar</RepositoryUrl>
    <PackageTags>menu;toolbar;dock;floating-island;ui;customization;zones</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Author Include="Meyblow" OsuProfileId="39791134" />
  </ItemGroup>

  <ItemGroup>
    <PluginDocument Include="README.md" Title="README" IconGlyph="Book" />
    <PluginDocument Include="CHANGELOG.md" Title="Changelog" IconGlyph="History" />
    <None Include="README.md;CHANGELOG.md;README.ru.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="osucc.Api" Version="2.2.0" />
    <PackageReference Include="osucc.Build" Version="2.2.0" PrivateAssets="all" />
    <PackageReference Include="ppy.osu.Game" Version="2026.702.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localisation/*.json" />
  </ItemGroup>

  <Target Name="DeployToOsuCc" AfterTargets="Build" Condition="Exists('$(APPDATA)\osu\osu-cc\plugins\extended-toolbar')">
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)README.md;$(ProjectDir)CHANGELOG.md;$(ProjectDir)README.ru.md" DestinationFolder="$(APPDATA)\osu\osu-cc\plugins\extended-toolbar" ContinueOnError="true" />
  </Target>

</Project>
